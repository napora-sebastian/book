# ---------------------------------------------------------------------------
# Where the DGX Spark GB10 cluster serves the model (OpenAI-compatible /v1 API)
# ---------------------------------------------------------------------------
# THESE THREE ARE ONLY THE STARTING POINT. Providers live in the database, set
# in the app's ⚙ LLM screen: a main provider plus a fallback chain, each with its
# own URL, key and model. The values here are used while nothing is saved there,
# and the first save imports them (key included) into the database.
#
# Pick ONE of these, depending on how you reach the Spark from the MacBook:
#
#   a) SSH tunnel (safest, works anywhere):   npm run tunnel
#      then use the localhost URL below.
#   b) NVIDIA Sync / LAN hostname:            http://spark.local:8000/v1
#   c) Tailscale:                             http://spark:8000/v1
#
# Common ports:  vLLM / TRT-LLM / NIM -> 8000    Ollama -> 11434    llama.cpp -> 8080
LLM_BASE_URL=http://127.0.0.1:8000/v1

# Model id exactly as the server advertises it (run `npm run doctor` to list).
LLM_MODEL=DeepSeek-v4-Flash-DSpark-1M-NVFP4-KV-2x-DGX-Spark

# Most local servers ignore this, but vLLM started with --api-key needs it.
LLM_API_KEY=local

# ---------------------------------------------------------------------------
# SSH tunnel target (used by `npm run tunnel`)
# ---------------------------------------------------------------------------
SPARK_SSH=sna@spark.local
SPARK_REMOTE_PORT=8000
LOCAL_PORT=8000

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
PORT=5173

# Characters of document text sent in a single request before the app switches
# to map-reduce. Map-reduce is lossy — it summarises sections then merges — so
# the goal is that a whole book never needs it. The cluster reports
# max_model_len = max_total_tokens = 1,048,576, and that budget is SHARED by
# prompt and output, so this reserves ~1M tokens of prompt at the measured
# 2.88 chars/token for Polish. Your 268,813-char book uses ~9% of it.
CONTEXT_BUDGET_CHARS=2500000

# Size of each chunk when map-reduce does kick in.
CHUNK_CHARS=48000
CHUNK_OVERLAP_CHARS=800

# Sampling
TEMPERATURE=0.2

# Output cap: reasoning AND answer come out of this one number, and on a
# reasoning model the thinking goes first — 4096 was too small to rewrite a
# chapter, which is why ds4-max once reasoned for 112s and answered nothing.
# At the measured ~36 tok/s this is a wall-clock setting as much as a size one:
#   16384 → ~47k chars of prose, worst case  8 min
#   32768 → ~94k chars of prose, worst case 15 min
#   65536 → ~189k chars,         worst case 30 min
# The app clamps this down automatically when a big document has already taken
# its share of the 1,048,576, so a long book shortens the answer instead of
# failing the request.
MAX_TOKENS=32768

# Hard ceiling the cluster enforces (prompt + completion combined).
MAX_TOTAL_TOKENS=1048576

# Chars per token used for the size estimates shown in the UI. Measured on this
# cluster against Polish prose: 269,448 chars → 93,538 tokens = 2.88. The usual
# English figure of ~3.6 under-reports Polish by a quarter.
CHARS_PER_TOKEN=2.9

# Tracing: every call to the cluster is recorded in the `traces` table.
# By default the document body is elided from the stored prompt (it already
# lives in `documents`, and storing it per turn would multiply a 600k-char book
# by the turn count). prompt_chars still records the true size sent.
# Set true to store prompts byte-for-byte — accurate but the DB grows fast.
TRACE_FULL_PROMPTS=false

# Upload limit (bytes) — 40 MB
MAX_UPLOAD_BYTES=41943040
